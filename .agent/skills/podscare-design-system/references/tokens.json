{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "PodsCare Design Tokens",
  "colors": {
    "brand": {
      "primary": "#176b58",
      "hover": "#125945",
      "light": "#e7f3ee",
      "mark": "#196d52",
      "accent": "#c8eadb"
    },
    "surface": {
      "canvas": "#f4f7f5",
      "card": "#ffffff",
      "panel": "#fafbfa"
    },
    "ink": {
      "primary": "#1c302b",
      "muted": "#758780",
      "subtle": "#9aa59f"
    },
    "line": {
      "default": "#e5ece8",
      "subtle": "#f0f3f1"
    },
    "status": {
      "wait": { "text": "#a4722f", "bg": "#faf3e7" },
      "progress": { "text": "#437a9d", "bg": "#edf4f8" },
      "ready": { "text": "#28805e", "bg": "#eaf5ef" },
      "danger": { "text": "#bc5b52", "bg": "#fbefed" },
      "new": { "text": "#7e729c", "bg": "#f2eff8" },
      "gray": { "text": "#77847e", "bg": "#f0f3f1" }
    }
  },
  "typography": {
    "fonts": {
      "body": "DM Sans, sans-serif",
      "heading": "Manrope, sans-serif"
    },
    "sizes": {
      "h1": { "fontSize": "23px", "fontWeight": 700, "letterSpacing": "-0.7px" },
      "h2": { "fontSize": "16px", "fontWeight": 700 },
      "h3": { "fontSize": "12px", "fontWeight": 700 },
      "stat": { "fontSize": "24px", "fontWeight": 700, "letterSpacing": "-0.8px" },
      "body": { "fontSize": "13px", "fontWeight": 400 },
      "caption": { "fontSize": "9px", "fontWeight": 700, "letterSpacing": "1.05px", "textTransform": "uppercase" }
    }
  },
  "shadows": {
    "card": "0 2px 5px rgba(36, 60, 41, 0.03)",
    "modal": "0 24px 90px rgba(18, 37, 27, 0.18)",
    "soft": "0 12px 38px rgba(28, 49, 34, 0.04)"
  },
  "radii": {
    "card": "10px",
    "btn": "7px",
    "badge": "20px"
  }
}
