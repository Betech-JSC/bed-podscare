# ==============================================================================
# PodsCare Repair OS - Web Client Environment Configuration
# ==============================================================================

# Backend REST API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Laravel Reverb / WebSocket Realtime Configuration
# ------------------------------------------------------------------------------
# Chạy môi trường Local:
# NEXT_PUBLIC_REVERB_APP_KEY=podscare_reverb_key
# NEXT_PUBLIC_REVERB_HOST=localhost
# NEXT_PUBLIC_REVERB_PORT=8080
# NEXT_PUBLIC_REVERB_SCHEME=http
#
# Khi deploy Production VPS:
# NEXT_PUBLIC_REVERB_APP_KEY=podscare_reverb_key
# NEXT_PUBLIC_REVERB_HOST=api.podscare.vn (hoặc domain VPS/Reverse Proxy)
# NEXT_PUBLIC_REVERB_PORT=443
# NEXT_PUBLIC_REVERB_SCHEME=https
NEXT_PUBLIC_REVERB_APP_KEY=podscare_reverb_key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http

# VietQR / SePay Payment Gateway Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VIETQR_BANK_ID=MB
NEXT_PUBLIC_VIETQR_ACCOUNT_NO=
NEXT_PUBLIC_VIETQR_ACCOUNT_NAME=
NEXT_PUBLIC_VIETQR_TEMPLATE=compact2

